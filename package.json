{
  "name": "docs-copy-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first monorepo MVP: web + gateway + sqlite",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "db:reset": "pnpm --filter @monorepo/gateway db:reset",
    "db:seed": "pnpm --filter @monorepo/gateway db:seed",
    "health": "curl -s http://localhost:3333/health",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^10.0.1",
    "prettier": "^3.1.0",
    "turbo": "^1.10.16",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
